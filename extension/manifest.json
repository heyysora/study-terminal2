{
  "manifest_version": 3,
  "name": "Study Terminal for TradingView",
  "version": "0.8.0",
  "description": "Optional companion for the Study Terminal desktop app: sends the active TradingView tab's symbol to your local copilot.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["https://www.tradingview.com/*", "https://tradingview.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Study Terminal",
              "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
