# Everything here is OPTIONAL. The app runs with no .env file at all.
# No brokerage account, no API keys. Copy to .env only if you want to change defaults.

# --- market data ---
MARKET_DATA_PROVIDER=yahoo
# stream_and_poll = Yahoo streaming socket + 1-min bar polling (default)
# poll_only       = polling only (labeled POLLING; signals limited to 5-min+ setups)
LIVE_MODE=stream_and_poll
POLL_INTERVAL_SECONDS=30
MAX_LIVE_SYMBOLS=40
MAX_REQUESTS_PER_MINUTE=60

# Watchlist created on first run (comma-separated)
DEFAULT_WATCHLIST=SPY,QQQ,AAPL,TSLA,NVDA

# Seconds without an update before a symbol is labeled STALE
REGULAR_HOURS_STALE_SECONDS=120
EXTENDED_HOURS_STALE_SECONDS=900

# --- paper trading simulator ---
PAPER_STARTING_CASH=25000
PAPER_MARGIN_MULTIPLIER=2        # 1 = cash account (no shorting)
PAPER_ALLOW_SHORT=true
PAPER_COMMISSION_PER_SHARE=0
PAPER_COMMISSION_PER_ORDER=0
PAPER_SLIPPAGE_BPS=1             # adverse slippage on market/stop fills: max(1 bp, PAPER_SLIPPAGE_MIN)
PAPER_SLIPPAGE_MIN=0.01
PAPER_SHORT_BORROW_FEE_ANNUAL_PCT=3

# --- risk limits ---
RISK_MAX_PER_TRADE_PCT=0.5
RISK_MAX_DAILY_LOSS_PCT=2
RISK_MAX_OPEN_POSITIONS=3
RISK_MIN_REWARD_RISK=2
RISK_REQUIRE_STOP=true

LOG_LEVEL=INFO
# STUDY_TERMINAL_DATA_DIR=        # default: %LOCALAPPDATA%\StudyTerminal

# --- optional: TopstepX API (read-only futures data; your own ProjectX subscription; never used for orders) ---
# STUDY_PROJECTX_USERNAME=
# STUDY_PROJECTX_API_KEY=
